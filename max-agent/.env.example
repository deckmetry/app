# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
WEBHOOK_SECRET=change-me-to-a-random-string

# ── GoHighLevel ───────────────────────────────────────────────────────────────
# GHL private-app API key (Settings → Integrations → API Keys)
GHL_API_KEY=
# Your GHL Location ID (Settings → Business Info → Location ID)
GHL_LOCATION_ID=
# The phone number MAX sends SMS from (must be a GHL-connected number, E.164 format)
GHL_FROM_NUMBER=+1xxxxxxxxxx
# Pipeline + stage names that signal "project complete" in your GHL account
GHL_COMPLETE_PIPELINE=Concept Sales Pipeline
GHL_COMPLETE_STAGE=Project Complete

# ── Google Ads ────────────────────────────────────────────────────────────────
# Developer token (apply at https://ads.google.com/aw/apicenter)
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth2 credentials from Google Cloud Console (Desktop app type)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Long-lived refresh token (run `node tools/get-google-ads-token.js` to generate)
GOOGLE_ADS_REFRESH_TOKEN=
# Your Google Ads Customer ID (no dashes, e.g. 1234567890)
GOOGLE_ADS_CUSTOMER_ID=
# If using a manager (MCC) account, set this to the MCC customer ID; otherwise leave blank
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Alerts ───────────────────────────────────────────────────────────────────
# GHL contact ID for Renan — anomaly alerts are sent as SMS to this contact
ALERT_CONTACT_ID=
# Renan's phone for direct SMS alerts (E.164)
ALERT_PHONE=+1xxxxxxxxxx
